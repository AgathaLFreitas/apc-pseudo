algoritmo "funcoesCaractere"

var 
  texto: caractere

  inicio
   texto <- "Sabrina"

   escreval("Texto original: ", texto)
   escreval("Copia de parte do texto: ", copia(texto,1,3))
   escreval("Quantidade de caracteres: ",compr(texto))
   escreval("Texto em maiúsculas: ", maiusc(texto))
   escreval("Posiçãp de'ri': ", pos("ri", texto))

fimalgoritmo